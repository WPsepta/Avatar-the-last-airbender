<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Avatar PS2 Recomp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnPickIso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih File Game (ISO)"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvIsoStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada file"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resolusi"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/seekRes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="3"
            android:progress="1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kualitas Grafis"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerGraphics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cheat"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/cbInfHealth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Infinite Health"
            android:textColor="#FFFFFF" />

        <CheckBox
            android:id="@+id/cbInfChi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Infinite Chi"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MULAI GAME"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>